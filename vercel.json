{
  "redirects": [
    {
      "source": "/r/:slug/:token",
      "destination": "https://backend-production-ab50.up.railway.app/api/public/rc/:token",
      "permanent": false
    },
    {
      "source": "/r/:id",
      "destination": "https://backend-production-ab50.up.railway.app/api/public/review-click/:id",
      "permanent": false
    },
    {
      "source": "/c/:linkToken/:recipientToken",
      "destination": "https://backend-production-ab50.up.railway.app/api/public/cc/:linkToken/:recipientToken",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(self)" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
